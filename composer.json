{
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "infection/infection": "^0.35.4"
    },
    "autoload": {
        "psr-4": {
            "App\\OrderCalculator\\": "OrderCalculator/",
            "App\\BankAccount\\": "BankAccount/",
            "App\\PasswordStrengthChecker\\": "PasswordStrengthChecker/",
            "App\\User\\": "User/",
            "App\\Weather\\": "Weather/",
            "App\\Checkout\\": "Checkout/",
            "App\\Audit\\": "Audit/",
            "App\\Notification\\": "Notification/",
            "App\\Payment\\": "Payment/",
            "App\\Report\\": "Report/",
            "StringCalculator\\": "StringCalculator/",
            "App\\StringCalculator\\": "StringCalculator/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "infection": "infection --threads=4"
    }
}
